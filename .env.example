# ---------------------------------------------------------------------------
# Copy to .env and fill in only what you need.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# --- LLM provider (OpenAI-compatible, no key required for a local gateway) ---
RAGBENCH_LLM_BASE_URL=http://127.0.0.1:3425/v1
RAGBENCH_LLM_MODEL=minimax-code-global/MiniMax-M3.1-Flash
# RAGBENCH_LLM_API_KEY=

# --- Embedding provider (OpenAI-compatible) --------------------------------
# Hosted NVIDIA NIM. The key is a secret: keep it in .env only.
RAGBENCH_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
RAGBENCH_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b
# RAGBENCH_EMBEDDING_API_KEY=

# Asymmetric embedding models encode queries and passages differently.
# Leave both empty for symmetric models (for example Ollama nomic-embed-text).
RAGBENCH_EMBEDDING_QUERY_INPUT_TYPE=query
RAGBENCH_EMBEDDING_PASSAGE_INPUT_TYPE=passage
# cold starts on hosted endpoints can exceed 60s
# RAGBENCH_EMBEDDING_TIMEOUT_SECONDS=180

# --- Local fallback provider (no key, run "ollama serve" first) --------------
# RAGBENCH_EMBEDDING_BASE_URL=http://localhost:11434/v1
# RAGBENCH_EMBEDDING_MODEL=nomic-embed-text
# RAGBENCH_EMBEDDING_QUERY_INPUT_TYPE=
# RAGBENCH_EMBEDDING_PASSAGE_INPUT_TYPE=

# --- Storage layout (relative to the project root) --------------------------
RAGBENCH_DATA_DIR=data
RAGBENCH_ARTIFACTS_DIR=artifacts

# --- Retrieval defaults ------------------------------------------------------
RAGBENCH_CHUNK_SIZE_TOKENS=800
RAGBENCH_CHUNK_OVERLAP_TOKENS=80
RAGBENCH_TOP_K=5
RAGBENCH_TOKENIZER_ENCODING=cl100k_base
